# systemd unit for heplify
#
# Install:
#   cp heplify.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now heplify

[Unit]
Description=heplify - HEP Agent and Collector
Documentation=https://github.com/sipcapture/heplify
After=network.target
Wants=network-online.target

[Service]
Environment="HEPLIFY_CONFIG=/etc/heplify/heplify.json"
ExecStart=/usr/local/bin/heplify -config ${HEPLIFY_CONFIG}
Restart=always
RestartSec=3s
Type=simple
LimitNOFILE=65536

# Run as an unprivileged user with only the capabilities that
# packet capture needs: NET_RAW for AF_PACKET/pcap, NET_ADMIN for promiscuous
# mode and fanout, NET_BIND_SERVICE for collector/API ports below 1024.
# Runs as homer:homer. If that user exists (for example from a HOMER
# install) it is used; otherwise systemd creates it dynamically.
User=homer
Group=homer
DynamicUser=yes
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Relative paths in the config (hep-buffer.dump, pcap output) end up in
# /var/lib/heplify, the only writable place besides /var/log/heplify.
StateDirectory=heplify
LogsDirectory=heplify
WorkingDirectory=/var/lib/heplify
UMask=0077

# Sandboxing
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Refuse blocked calls with EPERM instead of killing the process.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
